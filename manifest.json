{
  "manifest_version": 3,
  "name": "Language Companion",
  "version": "0.4.0",
  "description": "Understand Japanese and Korean while you browse: translate words and sentences on any page, in manga, in a reader view or in YouTube subtitles. Optionally save them to Anki.",
  "homepage_url": "https://github.com/mirodn/language-companion",
  "browser_specific_settings": {
    "gecko": {
      "id": "language-companion@mirodn",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "websiteContent"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": [
    "storage",
    "scripting",
    "alarms",
    "menus",
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*",
    "https://api.mymemory.translated.net/*",
    "https://api-free.deepl.com/*",
    "https://api.deepl.com/*",
    "https://en.wiktionary.org/*",
    "https://api.dictionaryapi.dev/*",
    "https://jisho.org/*",
    "https://api.tatoeba.org/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; base-uri 'none'; form-action 'none'; upgrade-insecure-requests;"
  },
  "optional_host_permissions": [
    "*://*/*",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "src/background/background.js"
    ],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/shared/messages.js",
        "src/shared/languages.js",
        "src/shared/settings.js",
        "src/shared/furigana.js",
        "src/content/selection.js",
        "src/content/popup-ui.js",
        "src/content/content.js",
        "src/content/image-text.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/content/peek.js",
        "src/content/youtube.js"
      ],
      "css": [
        "src/content/youtube.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Language Companion",
    "default_popup": "src/action/popup.html",
    "default_icon": "icons/icon.svg"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "commands": {
    "lookup-selection": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "Look up the selected text"
    },
    "lookup-and-add": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Look up the selected text and add it to Anki"
    }
  }
}
